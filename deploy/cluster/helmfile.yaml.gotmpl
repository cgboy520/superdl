# 平台组件(版本锁定,升级须走变更评审)。双档:
#   helmfile -e full apply    # RKE2 生产全组件
#   helmfile -e light apply   # k3s 单机/小规模(组件集同 full,k3s 侧 values 覆盖见 values/light/)
# 必须显式 -e;前置检查:./preflight.sh <full|light>
environments:
  full:
    values: [environments/full.yaml]
  light:
    values: [environments/light.yaml]
---
repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: nvidia
    url: https://helm.ngc.nvidia.com/nvidia
  - name: hami
    url: https://project-hami.github.io/HAMi
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: juicefs
    url: https://juicedata.github.io/charts
  - name: topolvm
    url: https://topolvm.github.io/topolvm
  - name: jetstack
    url: https://charts.jetstack.io
  - name: cloudnative-pg
    url: https://cloudnative-pg.github.io/charts
  # Loki(OSS)自 2026-03-16 起由社区仓维护(grafana/loki 转 GEL 专用);
  # 采集器 Alloy(promtail 2026-03-02 EOL 后的官方继任)仍在 grafana 仓
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts

releases:
  - name: cilium
    condition: cilium.enabled
    namespace: kube-system
    chart: cilium/cilium
    version: "1.20.0"
    values: [values/cilium.yaml]

  - name: gpu-operator
    condition: gpuOperator.enabled
    namespace: gpu-operator
    chart: nvidia/gpu-operator
    # 不得低于 v26.3.3:更低版本 device-plugin 会误注 ibverbs 设备。
    # HAMi 池节点以 nvidia.com/gpu.deploy.device-plugin=false 排斥官方插件
    # (见 values/gpu-operator.yaml 头注释);升版前复核 release notes 的 labels/ClusterPolicy 字段变化。
    version: "v26.3.3"
    values:
      - values/gpu-operator.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/gpu-operator-light.yaml
      {{- end }}
    # values 开了 ServiceMonitor:CRD 来自 kube-prometheus-stack,新集群首装必须排在它之后,
    # 且首装 diff 不做 API 校验(kind 尚不存在时 helm diff/install 会直接失败)
    needs: [monitoring/kube-prometheus-stack]
    disableValidationOnInstall: true

  # Kata(dedicated 档运行时):chart 装 shim 二进制、写 containerd drop-in、建 RuntimeClass kata-qemu。
  # k8sDistribution 决定往哪个 containerd 配置目录写 —— k3s/rke2 的 containerd 配置由发行版自己
  # 从模板生成,写错目录 = 装在没人读的地方(chart 侧会因与节点自检不符直接拒装)。
  # 只装 kata 池节点(values 的 nodeSelector);kata 池为空时 DaemonSet 0 副本,RuntimeClass 照建。
  - name: kata-deploy
    condition: kataDeploy.enabled
    namespace: kube-system
    chart: oci://ghcr.io/kata-containers/kata-deploy-charts/kata-deploy
    # 4.x 起只发 helm chart(3.x 的 kata-deploy/overlays/<distro> kustomize 目录已移除)
    version: "4.1.0"
    values: [values/kata-deploy.yaml]
    set:
      - name: k8sDistribution
        value: {{ if eq .Environment.Name "light" }}k3s{{ else }}rke2{{ end }}

  - name: hami
    condition: hami.enabled
    namespace: kube-system
    chart: hami/hami
    version: "2.9.0"
    values:
      - values/hami.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/hami-light.yaml
      {{- end }}

  - name: kube-prometheus-stack
    condition: kps.enabled
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: "88.0.0"
    values:
      - values/kps.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/kps-light.yaml
      {{- end }}
    # chart 的 CRD 在 crds/ 目录(helm install 先装 CRD 再装模板),但 helm diff 只干跑渲染不装 CRD,
    # 它自己的 Prometheus/Alertmanager/PrometheusRule/ServiceMonitor 在新集群首装的 diff 阶段必然校验失败
    disableValidationOnInstall: true

  - name: juicefs-csi-driver
    condition: juicefs.enabled
    namespace: kube-system
    chart: juicefs/juicefs-csi-driver
    version: "0.32.3"
    values: [values/juicefs.yaml]

  - name: topolvm
    condition: topolvm.enabled
    namespace: topolvm-system
    chart: topolvm/topolvm
    version: "17.0.0"
    values:
      - values/topolvm.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/topolvm-light.yaml
      {{- end }}
    hooks:
      # lvmd 挂载的 lvm.conf ConfigMap(issue_discards=1,P0-3)必须先于 chart 存在
      - events: ["presync"]
        showlogs: true
        command: "kubectl"
        args: ["apply", "-f", "topolvm/lvm-config.configmap.yaml"]

  - name: cert-manager
    condition: certManager.enabled
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: "1.19.1"
    values: [values/cert-manager.yaml]
    set:
      - name: crds.enabled
        value: "true"
    # values 开了 ServiceMonitor(monitoring.coreos.com CRD 由 kube-prometheus-stack 装):
    # 新集群首装必须排在 kps 之后,且首装 diff 不做 API 校验,否则整轮 apply 在 diff 阶段就失败
    needs: [monitoring/kube-prometheus-stack]
    disableValidationOnInstall: true
    {{- if .Values.acmeDns.enabled }}
    hooks:
      # acme-dns(DNS01 中转,P1-6)与 cert-manager 同 ns,先于此 chart 落地。
      # 只在 acmeDns.enabled 的档位应用:它的 LoadBalancer 53 端口在 k3s(klipper-lb)上会变成节点 hostPort 53,
      # 把节点自己发往 127.0.0.53 的查询也劫进 acme-dns(只认 auth 子域,其余 NXDOMAIN),节点从此解析不了任何域名
      # (Harbor 拉取、节点回连全断,light 首装实测);light 档默认不装,证书走平台侧通配证书
      - events: ["presync"]
        showlogs: true
        command: "kubectl"
        args: ["apply", "-f", "acme-dns.yaml"]
    {{- end }}

  # 北向唯一入口:Envoy Gateway(Gateway API 实现),1:1 顶掉 2026-03 退休的 ingress-nginx
  # (最后版本 controller-v1.15.1,此后不再修任何 CVE)。数据面 Envoy 与控制面同 ns
  # (不开 Gateway Namespace Mode),所以 envoy-gateway-system 就是原 ingress-nginx ns 的替代——
  # 凡是按 ns 名认入口的地方(NetworkPolicy 来源、准入豁免名单)都要跟着换,漏一处就是网关起不来。
  - name: envoy-gateway
    condition: envoyGateway.enabled
    namespace: envoy-gateway-system
    chart: oci://docker.io/envoyproxy/gateway-helm
    # chart v1.9.0 = 控制面 v1.9.0 + 内置 Envoy distroless-v1.39.0,对齐 Gateway API v1.6.1;
    # 升版前先跑 ./gateway-api-crds.sh 升 CRD(本 chart 不管 CRD),再 helm diff 复核
    version: "v1.9.0"
    values:
      - values/envoy-gateway.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/envoy-gateway-light.yaml
      {{- end }}
    set:
      # chart 自带的 CRD 子 chart 走 helm 的 crds/ 目录,该目录在 helm upgrade 时永不更新:
      # 跟着 chart 装,CRD 会永远停在首装那一版。改由下面的 presync 钩子单点管理。
      - name: crds.enabled
        value: "false"
    hooks:
      # CRD 必须先于 chart 存在:控制面一起来就 list/watch GatewayClass/Gateway,缺 CRD 时
      # 它反复重启,且本 release 的 diff 阶段先一步失败。channel 首装即定、事后换不回去
      # (safe-upgrades 策略拒绝 standard→experimental),细节见脚本头注释。
      - events: ["presync"]
        showlogs: true
        command: "./gateway-api-crds.sh"

  # CloudNativePG:平台库进 K8s 时的唯一受支持形态(见 ../README.md「生产数据库要求」)。
  # 默认关闭(cnpg.enabled=false,用托管 PG 时不装);启用时 operator 与业务集群两个 release 一起进。
  - name: cloudnative-pg
    condition: cnpg.enabled
    namespace: cnpg-system
    chart: cloudnative-pg/cloudnative-pg
    # chart 0.29.0 = operator 1.30.0
    version: "0.29.0"

  - name: cnpg-cluster
    condition: cnpg.enabled
    namespace: superdl
    chart: cloudnative-pg/cluster
    # 升版时 values 键名以新版为准(先 helm template 验证)
    version: "0.8.1"
    needs:
      - cnpg-system/cloudnative-pg
    disableValidationOnInstall: true   # Cluster/ScheduledBackup 的 CRD 来自 operator release,首装 diff 免校验
    values: [values/cnpg-cluster.yaml]

  # 日志栈:Loki 单副本 + Alloy 采集(全 Pod 日志 + 控制面 apiserver 审计文件)。
  # API 审计相关日志经此留存 ≥6 个月(查询方式见 runbooks/loki-logging.md)。
  # light 档默认同开(可承受资源已收紧);磁盘紧张可在 environments/light.yaml 整栈关掉。
  - name: loki
    condition: loki.enabled
    namespace: monitoring
    chart: grafana-community/loki
    # chart 18.9.1 = Loki 3.7.6;values 按 Monolithic 部署形态
    version: "18.9.1"
    values:
      - values/loki.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/loki-light.yaml
      {{- end }}
    # values 开了 ServiceMonitor:同 cert-manager,排在 kps 之后、首装免校验
    needs: [monitoring/kube-prometheus-stack]
    disableValidationOnInstall: true

  - name: alloy
    condition: logCollector.enabled
    namespace: monitoring
    chart: grafana/alloy
    # chart 1.11.1 = Alloy v1.18.1;promtail chart 已废弃,不引入
    version: "1.11.1"
    needs:
      - monitoring/loki
    values: [values/alloy.yaml]

# 注:admission/tenant-restrictions.yaml(ValidatingAdmissionPolicy)不是 helm release,
# 不纳入本文件;由发布流程单独 kubectl apply(步骤见 README 两档「组件」节),
# preflight.sh 强制校验集群内两个 Binding 存在且 validationActions 含 Deny。
