# 平台组件(版本锁定,升级须走变更评审)。双档:
#   helmfile -e full apply    # RKE2 生产全组件
#   helmfile -e light apply   # k3s 单机/小规模(仅共享档,见 environments/light.yaml)
# 必须显式 -e;前置检查:./preflight.sh <full|light>
environments:
  full:
    values: [environments/full.yaml]
  light:
    values: [environments/light.yaml]
---
repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: nvidia
    url: https://helm.ngc.nvidia.com/nvidia
  - name: hami
    url: https://project-hami.github.io/HAMi
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: juicefs
    url: https://juicedata.github.io/charts
  - name: topolvm
    url: https://topolvm.github.io/topolvm
  - name: jetstack
    url: https://charts.jetstack.io
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

releases:
  - name: cilium
    condition: cilium.enabled
    namespace: kube-system
    chart: cilium/cilium
    version: "1.20.0"
    values: [values/cilium.yaml]

  - name: gpu-operator
    condition: gpuOperator.enabled
    namespace: gpu-operator
    chart: nvidia/gpu-operator
    version: "v26.3.0"
    values: [values/gpu-operator.yaml]

  - name: hami
    condition: hami.enabled
    namespace: kube-system
    chart: hami/hami
    version: "2.9.0"
    values:
      - values/hami.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/hami-light.yaml
      {{- end }}

  - name: kube-prometheus-stack
    condition: kps.enabled
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: "88.0.0"
    values:
      - values/kps.yaml
      {{- if eq .Environment.Name "light" }}
      - values/light/kps-light.yaml
      {{- end }}

  - name: juicefs-csi-driver
    condition: juicefs.enabled
    namespace: kube-system
    chart: juicefs/juicefs-csi-driver
    version: "0.32.3"
    values: [values/juicefs.yaml]

  - name: topolvm
    condition: topolvm.enabled
    namespace: topolvm-system
    chart: topolvm/topolvm
    version: "17.0.0"
    values: [values/topolvm.yaml]

  - name: cert-manager
    condition: certManager.enabled
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: "1.19.1"
    values: [values/cert-manager.yaml]
    set:
      - name: crds.enabled
        value: "true"

  - name: ingress-nginx
    condition: ingressNginx.enabled
    namespace: ingress-nginx
    chart: ingress-nginx/ingress-nginx
    version: "4.13.0"
    values: [values/ingress-nginx.yaml]
