# 行尾统一 LF,与 .editorconfig 的 end_of_line = lf 一致。
# 闸门与运行时都在 Linux:脚本带 CR 会让 bash -n / shellcheck / bats 直接失败;
# COPY 进镜像的 entrypoint.sh 带 CR 则 shebang 找不到解释器,容器起不来;
# openapi.json 由 Python 按平台行尾写出,仓库不定行尾时「契约无 diff」闸门必红。
* text=auto eol=lf

# shell 脚本显式约束:Linux 节点/CI/容器内执行,blob 必须是 LF
# (Windows 编辑器 + autocrlf 曾把 CRLF 带进 blob:CI 的 bash -n 门禁、
#  下发到 GPU 节点的 node-join.sh、实例镜像 entrypoint 均会直接语法错误)。
*.sh text eol=lf
*.bats text eol=lf

# 二进制:任何情况下不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
