          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "phone": {
            "description": "中国大陆手机号",
            "pattern": "^1[3-9]\\d{9}$",
            "title": "Phone",
            "type": "string"
          },
          "sms_code": {
            "anyOf": [
              {
                "maxLength": 8,
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sms Code"
          }
        },
        "required": [
          "phone"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
