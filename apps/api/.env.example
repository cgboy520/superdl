# 复制为 .env 使用。全部变量见 app/core/config.py(前缀 SUPERDL_)。
# 支付 / 短信 / 实名 / 备案 / 镜像仓库 / 集群接入:env 为默认值层,经管理端·平台配置在线覆盖。
SUPERDL_ENVIRONMENT=dev
# 非本机 PG 在 prod 必须 ?sslmode=require(或 verify-ca/verify-full)
SUPERDL_DATABASE_URL=postgresql+asyncpg://superdl:superdl@localhost:5432/superdl
SUPERDL_JWT_SECRET=dev-secret-change-me
# 日志级别:DEBUG/INFO/WARNING/ERROR/CRITICAL
# SUPERDL_LOG_LEVEL=INFO
# Alertmanager 告警接入 token
# SUPERDL_ALERTMANAGER_TOKEN=<随机强 token>
# 平台配置敏感项加密主密钥(dev 不设则从 jwt_secret 派生;prod 必配)
# 生成:python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# SUPERDL_CONFIG_ENCRYPTION_KEY=<urlsafe-base64 32 字节>
# 轮换窗口内的旧主密钥(见 deploy/cluster/runbooks/key-rotation.md)
# SUPERDL_CONFIG_ENCRYPTION_KEY_PREVIOUS=<urlsafe-base64 32 字节>
# 人机校验(/auth/sms-code 前置闸),默认关;见 docs/reference/security.md
# SUPERDL_CAPTCHA_ENABLED=true
# 管理端 TOTP 总开关,默认开
# SUPERDL_ADMIN_MFA_ENABLED=false
# SUPERDL_CAPTCHA_SCENE_ID= / SUPERDL_CAPTCHA_PREFIX= / SUPERDL_CAPTCHA_ACCESS_KEY_ID= / SUPERDL_CAPTCHA_ACCESS_KEY_SECRET=
# 镜像仓库(Harbor);dev 可不填
# SUPERDL_REGISTRY_HOST=harbor.example.com
# SUPERDL_REGISTRY_PROJECT=superdl
# SUPERDL_REGISTRY_ROBOT_NAME=robot$superdl+pull
# SUPERDL_REGISTRY_ROBOT_SECRET=
# SUPERDL_IMAGE_ALLOWED_REGISTRIES=docker.io/   # 换行/逗号分隔的仓库前缀;空 = 不限制
# 集群接入(节点一键加入);发行版由平台探测
# SUPERDL_CLUSTER_SERVER_URL=https://<vip>:9345   # rke2 9345 / k3s 6443;HA 填控制面 VIP
# SUPERDL_CLUSTER_JOIN_TOKEN=<agent-token>   # 不是 server/node-token,见 deploy/cluster/README.md
# SUPERDL_CLUSTER_AGENT_VERSION=v1.36.2+rke2r1
# SUPERDL_NODE_INSTALL_MIRROR=cn         # cn(默认)/ official
# SUPERDL_NODE_DRIVER_VERSION=580
# SUPERDL_NODE_REGISTRIES_YAML=<deploy/cluster/rke2/registries.yaml 内容>

