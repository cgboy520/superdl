{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "i18n": "i18next-cli extract --ci && i18next-cli types --ci && i18next-cli lint",
    "i18n:write": "i18next-cli extract && i18next-cli types"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@superdl/api-client": "workspace:*",
    "@superdl/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.0",
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "i18next-cli": "^1.71.0",
    "jsdom": "^30.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
