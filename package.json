{
  "name": "superdl",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api-client": "pnpm --filter @superdl/api-client generate",
    "i18n": "turbo run i18n && pnpm run copy-check",
    "copy-check": "bash scripts/check-cjk.sh && bash scripts/check-copy-banned.sh",
    "csp-check": "bash scripts/check-csp-hash.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
